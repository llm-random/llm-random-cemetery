   "source": [
    "seq_len = 6\n",
    "context_length = 3\n",
    "attn_mask = torch.ones(seq_len, seq_len, dtype=torch.bool)\n",
    "attn_mask = torch.tril(attn_mask) & ~torch.tril(attn_mask, diagonal=-context_length)# Ensure lower triangular mask for autoregressive behavior\n",
    "print(attn_mask)"
   ]
