#!/bin/bash -l

#SBATCH --array=0-2
#SBATCH --account=plgllmefficont3
#SBATCH --cpus-per-gpu=16
#SBATCH --gres=gpu:hopper:4
#SBATCH --job-name=bdd_llama1B_lr
#SBATCH --mem-per-gpu=220G
#SBATCH --nodes=1
#SBATCH --partition=plgrid-lem-gpu-h100
#SBATCH --time=1-00:00:00

#---------- SCRIPT ----------
export WANDB_API_KEY="__WANDB_API_KEY_PLACEHOLDER__"
# export HF_TOKEN="__HF_TOKEN_PLACEHOLDER__"  # Warning: HF_TOKEN not found in environment. This might lead to issues.
SECRETS_DIR=$HOME/.config/bdd/secrets
if [ -z "$WANDB_API_KEY" ] && [ -s "$SECRETS_DIR/wandb_api_key" ]; then export WANDB_API_KEY="$(cat "$SECRETS_DIR/wandb_api_key")"; fi
if [ -z "$HF_TOKEN" ] && [ -s "$SECRETS_DIR/hf_token" ]; then export HF_TOKEN="$(cat "$SECRETS_DIR/hf_token")"; fi
export PROJECT_HOME_PATH=/lustre/pd03/plgrid/plgllmefficont3/nano
export HF_HOME=$PROJECT_HOME_PATH/hf_cache
export HYDRA_FULL_ERROR=1
export USER_HOME_PATH=$PROJECT_HOME_PATH/$USER
export HF_DATASETS_CACHE="$USER_HOME_PATH/hf_datasets"
export HF_MODULES_CACHE="$USER_HOME_PATH/hf_modules"
export HF_HUB_CACHE="$USER_HOME_PATH/hf_cache"
export HF_DATASETS_TRUST_REMOTE_CODE=1
export PIXI_HOME=$USER_HOME_PATH/pixi
export PATH="$HOME/.pixi/bin:$PATH"
export XDG_DATA_HOME="$USER_HOME_PATH/data"
export XDG_CACHE_HOME="$USER_HOME_PATH/cache"
export XDG_STATE_HOME="$USER_HOME_PATH/state"
export RATTLER_CACHE_DIR="$XDG_CACHE_HOME/rattler"
export PIXI_CACHE_DIR="$XDG_CACHE_HOME/pixi"
cd "$PIXI_HOME"
eval "$(pixi shell-hook)"
cd -
#-------- SCRIPT END --------


export MASTER_ADDR=$(scontrol show hostname ${SLURM_NODELIST} | head -n 1)
if [ -z "${SLURM_ARRAY_TASK_ID}" ]; then
    export MASTER_PORT=$((40000 + ${SLURM_JOB_ID} % 10000))
else
    export MASTER_PORT=$((30000 + (${SLURM_JOB_ID} % 1250) * 8 + (${SLURM_ARRAY_TASK_ID} % 8)))
fi
srun torchrun --nnodes=${SLURM_NNODES}\
  --nproc-per-node=${SLURM_GPUS_ON_NODE} \
  --rdzv-id=${SLURM_JOBID} \
  --rdzv-backend=c10d \
  --rdzv-endpoint=${MASTER_ADDR}:${MASTER_PORT} \
  main.py \
    --config-path=generated_configs \
    --config-name=config_${SLURM_ARRAY_TASK_ID}.yaml \
    +checkpoint_config.slurm_array_task_id=${SLURM_ARRAY_TASK_ID}