#!/bin/bash -l

#SBATCH --array=0-0
#SBATCH --account=plgllmefficont3-gpu-gh200
#SBATCH --cpus-per-gpu=32
#SBATCH --gres=gpu:1
#SBATCH --job-name=smoke_helios_h16_ps
#SBATCH --mem-per-gpu=109G
#SBATCH --nodes=1
#SBATCH --partition=plgrid-gpu-gh200
#SBATCH --qos=now
#SBATCH --time=0-01:30:00

#---------- SCRIPT ----------
# export WANDB_API_KEY="__WANDB_API_KEY_PLACEHOLDER__"  # Warning: WANDB_API_KEY not found in environment. This might lead to issues.
# export HF_TOKEN="__HF_TOKEN_PLACEHOLDER__"  # Warning: HF_TOKEN not found in environment. This might lead to issues.
module load ML-bundle/25.04
export PROJECT_HOME_PATH=$PLG_GROUPS_STORAGE/plggllmeffi3/pc
export HF_HOME=$PROJECT_HOME_PATH/hf_cache
export HF_DATASETS_CACHE="$PROJECT_HOME_PATH/hf_datasets"
export HF_MODULES_CACHE="$PROJECT_HOME_PATH/hf_modules"
export HYDRA_FULL_ERROR=1
export PIXI_HOME=$PROJECT_HOME_PATH/$USER/pixi
export PATH="$HOME/.pixi/bin:$PATH"
export XDG_DATA_HOME="$PROJECT_HOME_PATH/data"
export XDG_CACHE_HOME="$PROJECT_HOME_PATH/cache"
export XDG_STATE_HOME="$PROJECT_HOME_PATH/state"
export RATTLER_CACHE_DIR="$XDG_CACHE_HOME/rattler"
export UV_CACHE_DIR="$XDG_CACHE_HOME/uv"
export PIXI_CACHE_DIR="$XDG_CACHE_HOME/pixi"
export HF_DATASETS_TRUST_REMOTE_CODE=1
cd "$PIXI_HOME"
eval "$(pixi shell-hook)"
cd -
export FINEWEB_DIR=/net/storage/pr3/plgrid/plggllmeffi3/datasets/fineweb/train
if [ -n "$(find "$SCRATCH/datasets/fineweb/train/.complete" -mtime -28 2>/dev/null)" ]; then export FINEWEB_DIR="$SCRATCH/datasets/fineweb/train"; fi
echo "FineWeb: $FINEWEB_DIR"
#-------- SCRIPT END --------


export MASTER_ADDR=$(scontrol show hostname ${SLURM_NODELIST} | head -n 1)
if [ -z "${SLURM_ARRAY_TASK_ID}" ]; then
    export MASTER_PORT=$((40000 + ${SLURM_JOB_ID} % 10000))
else
    export MASTER_PORT=$((30000 + (${SLURM_JOB_ID} % 1250) * 8 + (${SLURM_ARRAY_TASK_ID} % 8)))
fi
srun torchrun --nnodes=${SLURM_NNODES}\
  --nproc-per-node=${SLURM_GPUS_ON_NODE} \
  --rdzv-id=${SLURM_JOBID} \
  --rdzv-backend=c10d \
  --rdzv-endpoint=${MASTER_ADDR}:${MASTER_PORT} \
  main.py \
    --config-path=generated_configs \
    --config-name=config_${SLURM_ARRAY_TASK_ID}.yaml \
    +checkpoint_config.slurm_array_task_id=${SLURM_ARRAY_TASK_ID}