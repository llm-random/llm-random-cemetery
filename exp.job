#!/bin/bash -l

#SBATCH --account=plgllmefficont3
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:hopper:1
#SBATCH --job-name=test
#SBATCH --mem=220G
#SBATCH --nodes=1
#SBATCH --partition=plgrid-lem-gpu-h100
#SBATCH --time=06:00:00

#---------- SCRIPT ----------
ml CUDA/12.4.0
export WANDB_API_KEY="__WANDB_API_KEY_PLACEHOLDER__"
export HF_TOKEN="__HF_TOKEN_PLACEHOLDER__"
export PROJECT_HOME_PATH=/lustre/pd03/plgrid/plgllmefficont3/nano/$USER
export HF_HOME=$PROJECT_HOME_PATH/hf_cache
export HYDRA_FULL_ERROR=1
export HF_DATASETS_CACHE="$PROJECT_HOME_PATH/hf_datasets"
export HF_MODULES_CACHE="$PROJECT_HOME_PATH/hf_modules"
export PIXI_HOME=$PROJECT_HOME_PATH/pixi
export PATH="$HOME/.pixi/bin:$PATH"
export HF_DATASETS_TRUST_REMOTE_CODE=1
cd "$PIXI_HOME"
eval "$(pixi shell-hook)"
cd -
#-------- SCRIPT END --------

python evaluate_hf_models.py \
  --config-path=configs/pc_project \
  --config-name=downstream_eval