#!/bin/bash -l
#SBATCH --job-name=post_e3_entropy
#SBATCH --nodes=1
#SBATCH --time=0-01:30:00
#SBATCH --output=rebuttal_jobs/post_e3_entropy/slurm-%j.out
#SBATCH --partition=h100
#SBATCH --gres=gpu:h100:1
#SBATCH --cpus-per-gpu=14
#SBATCH --mem-per-gpu=90G

#---------- SCRIPT ----------
# export WANDB_API_KEY="__WANDB_API_KEY_PLACEHOLDER__"  # Warning: WANDB_API_KEY not found in environment. This might lead to issues.
# export HF_TOKEN="__HF_TOKEN_PLACEHOLDER__"  # Warning: HF_TOKEN not found in environment. This might lead to issues.
export PROJECT_HOME_PATH=/storage_nvme_4/nano
export HF_HOME=$PROJECT_HOME_PATH/hf_cache
export HYDRA_FULL_ERROR=1
export PIXI_HOME=$PROJECT_HOME_PATH/$USER/pixi
export PATH="$HOME/.pixi/bin:$PATH"
export XDG_DATA_HOME="$PIXI_HOME/data"
export XDG_CACHE_HOME="$PIXI_HOME/cache"
export XDG_STATE_HOME="$PIXI_HOME/state"
cd "$PIXI_HOME"
eval "$(pixi shell-hook)"
cd -
#-------- SCRIPT END --------

export MASTER_ADDR=localhost
export MASTER_PORT=$((40000 + SLURM_JOB_ID % 10000))
CK=/storage_nvme_4/nano/mstefaniak/checkpoints/rebuttal
OUT=/storage_nvme_4/nano/mstefaniak/checkpoints/rebuttal/post_e3_entropy
mkdir -p "$OUT"
set -x
for J in rb_e3_pcd90_2bt_s0_masked_ent rb_e3_pcd70_2bt_s0_masked_ent; do
  STEP=$(ls -d $CK/$J/*/0/step_4095 2>/dev/null | tail -1)
  if [ -n "$STEP" ] && [ -d "$STEP/model" ]; then
    torchrun --nnodes=1 --nproc-per-node=1 --master-port=$MASTER_PORT scripts/rebuttal/e4_knockout.py --job-config rebuttal_jobs/$J/config_0.yaml --ckpt "$STEP" --out "$OUT/e4_$J.json" || echo "E4 FAILED $J"
  else echo "E4 SKIP $J: no checkpoint"; fi
done
